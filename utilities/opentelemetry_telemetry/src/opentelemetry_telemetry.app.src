{application, opentelemetry_telemetry,
 [{description, "Telemetry to OpenTelemetry Bridge"},
  {vsn, "1.2.0"},
  {registered, [opentelemetry_telemetry_sup, otel_telemetry_spans]},
  {mod, {opentelemetry_telemetry_app, []}},
  {applications,
   [kernel,
    stdlib,
    opentelemetry,
    opentelemetry_api,
    telemetry
   ]},
  {env,[]},
  {modules, []},

  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/open-telemetry/opentelemetry-erlang-contrib/tree/main/utilities/opentelemetry_telemetry"}]}
 ]}.
